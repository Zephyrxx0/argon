# ==============================================================================
# Argon Production Environment Configuration
# Copy this file to .env.production on your GCP VM and fill in your values
# ==============================================================================

# Your public domain pointing to your GCP VM external IP (e.g. argon.yourdomain.com)
DOMAIN=argon.example.com

# Email used by Caddy for automatic Let's Encrypt SSL registration & expiration notices
ACME_EMAIL=admin@example.com

# Secrets (Generate with: openssl rand -hex 32)
GATEWAY_SECRET=replace_with_64_char_hex_secret_for_gateway
BETTER_AUTH_SECRET=replace_with_64_char_hex_secret_for_better_auth

# Google Gemini API key for briefing narration and graph analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Provider: 'gemini' (recommended for production) or 'local' (runs ONNX on CPU)
EMBEDDING_PROVIDER=gemini

# GitHub OAuth App credentials for user authentication & private repo access
# Create at https://github.com/settings/developers
# Homepage URL: https://<DOMAIN>
# Authorization callback URL: https://<DOMAIN>/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

