{
  "name": "argon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:healthcheck": "docker compose ps --filter health=healthy --format json | grep -q argon-falkordb && echo 'FalkorDB is healthy' || (docker compose ps && exit 1)",
    "seed:showcase": "pnpm --filter @argon/eval seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
